---
// src/pages/[category].astro
// Builds one archive page per WordPress category: /crime/, /financial/, etc.
// /blog/ keeps its own page (static routes beat dynamic ones in Astro).
import Layout from "../layouts/Layout.astro"

export async function getStaticPaths() {
    const wpUrl = "https://cms.casinous.com/graphql"

    const gql = async (query: string, variables: Record<string, any> = {}) => {
        const res = await fetch(wpUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ query, variables }),
        })
        const json = await res.json()
        if (json.errors) {
            console.error(
                "❌ GRAPHQL CATEGORY ERROR:",
                JSON.stringify(json.errors, null, 2),
            )
            throw new Error("WordPress rejected the GraphQL query for categories.")
        }
        return json.data
    }

    // Slugs that already have their own route, or should never get one
    const SKIP_SLUGS = ["blog", "uncategorized"]

    // --- 1. ALL NON-EMPTY CATEGORIES ---
    const categories: any[] = []
    let catCursor: string | null = null
    do {
        const data = await gql(
            `query GetCategories($after: String) {
                categories(first: 100, after: $after, where: { hideEmpty: true }) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        name slug description count
                        seo { title metaDesc schema { raw } }
                    }
                }
            }`,
            { after: catCursor },
        )
        categories.push(...data.categories.nodes)
        catCursor = data.categories.pageInfo.hasNextPage
            ? data.categories.pageInfo.endCursor
            : null
    } while (catCursor)

    // --- 2. POSTS FOR EACH CATEGORY ---
    const paths = []
    for (const cat of categories) {
        if (!cat.slug || SKIP_SLUGS.includes(cat.slug)) continue

        const posts: any[] = []
        let postCursor: string | null = null
        do {
            const data = await gql(
                `query GetCategoryPosts($slug: String, $after: String) {
                    posts(first: 100, after: $after, where: { categoryName: $slug }) {
                        pageInfo { hasNextPage endCursor }
                        nodes {
                            uri title date
                            featuredImage { node { sourceUrl altText } }
                            author { node { name firstName lastName } }
                        }
                    }
                }`,
                { slug: cat.slug, after: postCursor },
            )
            posts.push(...data.posts.nodes)
            postCursor = data.posts.pageInfo.hasNextPage
                ? data.posts.pageInfo.endCursor
                : null
        } while (postCursor)

        if (posts.length === 0) continue

        posts.sort(
            (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
        )

        paths.push({
            params: { category: cat.slug },
            props: { category: cat, posts },
        })
    }

    return paths
}

const { category, posts } = Astro.props

const LIVE_SITE = "https://www.casinous.com"
const currentYear = new Date().getFullYear().toString()

// Thin archives (1–2 posts) stay out of Google until they fill up
const MIN_POSTS_TO_INDEX = 3
const vercelEnv = process.env.VERCEL_ENV
const isPreviewBuild = !!vercelEnv && vercelEnv !== "production"
const robotsTag =
    isPreviewBuild || posts.length < MIN_POSTS_TO_INDEX
        ? "noindex, follow"
        : "index, follow"

const canonicalUrl = `${LIVE_SITE}/${category.slug}/`

const seoTitle = (
    category.seo?.title || `${category.name} News & Articles | Casino US`
).replaceAll("[year]", currentYear)

const stripHtml = (s: string) => (s || "").replace(/<\/?[^>]+(>|$)/g, "").trim()

const seoDesc = (
    category.seo?.metaDesc ||
    stripHtml(category.description) ||
    `The latest ${category.name.toLowerCase()} news and articles from the Casino US team.`
).replaceAll("[year]", currentYear)

let schema = category.seo?.schema?.raw || undefined
if (schema) {
    schema = schema
        .replaceAll("https://cms.casinous.com", LIVE_SITE)
        .replaceAll("/uncategorized/", "/blog/")
}

const intro =
    stripHtml(category.description) ||
    `The latest ${category.name.toLowerCase()} stories from the Casino US newsroom.`

const cards = posts.map((p: any) => {
    const rel = (p.uri || "").replace(/https?:\/\/[^/]+/i, "")
    const link = `/${rel.replace(/^\/|\/$/g, "")}/`

    let image = p.featuredImage?.node?.sourceUrl || ""
    if (image) {
        try {
            image = new URL(image).pathname
        } catch (e) {}
    }

    const a = p.author?.node
    const author = a
        ? a.firstName && a.lastName
            ? `${a.firstName} ${a.lastName}`
            : a.name
        : "Editorial Team"

    const date = new Date(p.date).toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "short",
        year: "numeric",
    })

    return {
        link,
        image,
        alt: p.featuredImage?.node?.altText || stripHtml(p.title),
        title: (p.title || "").replaceAll("[year]", currentYear),
        author,
        date,
        datetime: p.date,
    }
})
---

<Layout
    title={seoTitle}
    seoTitle={seoTitle}
    description={seoDesc}
    schema={schema}
    canonical={canonicalUrl}
    robots={robotsTag}
>
    <main class="cus-cat">
        <div class="cus-cat__inner">
            <nav class="cus-cat__crumbs" aria-label="breadcrumb">
                <a href="/">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/blog/">Blog</a>
                <span aria-hidden="true">/</span>
                <span class="current">{category.name}</span>
            </nav>

            <header class="cus-cat__head">
                <h1 class="cus-cat__title" set:html={category.name} />
                <p class="cus-cat__intro">{intro}</p>
            </header>

            <ul class="cus-cat__grid">
                {
                    cards.map(c => (
                        <li class="cus-cat__card">
                            <a href={c.link} class="cus-cat__thumb">
                                {c.image && (
                                    <img
                                        src={c.image}
                                        alt={c.alt}
                                        width="1200"
                                        height="630"
                                        loading="lazy"
                                        decoding="async"
                                        referrerpolicy="no-referrer"
                                    />
                                )}
                            </a>
                            <h2 class="cus-cat__card-title">
                                <a href={c.link} set:html={c.title} />
                            </h2>
                            <p class="cus-cat__meta">
                                <span set:html={category.name} />
                                <span class="dot" aria-hidden="true">•</span>
                                <time datetime={c.datetime}>{c.date}</time>
                                <span class="dot" aria-hidden="true">•</span>
                                <span>{c.author}</span>
                            </p>
                        </li>
                    ))
                }
            </ul>

            <a href="/blog/" class="cus-cat__all">See all news and blogs</a>
        </div>
    </main>
</Layout>

<style>
    .cus-cat {
        background: #f8fafc;
        padding: 3rem 1rem 4rem;
    }
    .cus-cat__inner {
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .cus-cat__crumbs {
        display: flex;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 1.75rem;
    }
    .cus-cat__crumbs a {
        color: #2563eb;
        text-decoration: none;
    }
    .cus-cat__crumbs a:hover {
        text-decoration: underline;
    }
    .cus-cat__crumbs .current {
        color: #0f172a;
    }

    .cus-cat__head {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 2rem;
        margin-bottom: 3.5rem;
    }
    .cus-cat__title {
        position: relative;
        padding-left: 2.75rem;
        margin: 0 0 1.25rem;
        font-size: clamp(2rem, 4vw, 3.4rem);
        font-weight: 900;
        line-height: 1.1;
        text-transform: uppercase;
        color: #0f172a;
    }
    .cus-cat__title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        width: 1.9rem;
        height: 6px;
        background: #dc2626;
        transform: translateY(-50%);
    }
    .cus-cat__intro {
        margin: 0;
        max-width: 70ch;
        font-size: 1.15rem;
        line-height: 1.6;
        color: #475569;
    }

    .cus-cat__grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 2.5rem 2.5rem;
    }
    .cus-cat__thumb {
        display: block;
        aspect-ratio: 360 / 250;
        border-radius: 6px;
        overflow: hidden;
        background: #eef2f6;
        margin-bottom: 1.25rem;
    }
    .cus-cat__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .cus-cat__card-title {
        margin: 0 0 0.75rem;
        font-size: 1.3rem;
        font-weight: 800;
        line-height: 1.3;
    }
    .cus-cat__card-title a {
        color: #0f172a;
        text-decoration: none;
    }
    .cus-cat__card-title a:hover,
    .cus-cat__card-title a:focus-visible {
        color: #2563eb;
    }
    .cus-cat__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 0.6rem;
        margin: 0;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
    }
    .cus-cat__meta .dot {
        font-size: 0.6rem;
    }

    .cus-cat__all {
        display: inline-block;
        margin-top: 3.5rem;
        padding: 0.75rem 1.4rem;
        border: 1.5px solid #2563eb;
        border-radius: 8px;
        color: #2563eb;
        font-weight: 700;
        text-decoration: none;
    }
    .cus-cat__all:hover,
    .cus-cat__all:focus-visible {
        background: #2563eb;
        color: #ffffff;
    }

    @media (max-width: 1100px) {
        .cus-cat__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (max-width: 600px) {
        .cus-cat {
            padding-top: 1.5rem;
        }
        .cus-cat__grid {
            grid-template-columns: minmax(0, 1fr);
        }
        .cus-cat__title {
            padding-left: 2.25rem;
        }
        .cus-cat__title::before {
            width: 1.5rem;
            height: 5px;
        }
    }
</style>